rules_version = '2';

// ---------------------------------------------------------------------------
// MyLife Firestore Security Rules
// ---------------------------------------------------------------------------
// Matches the data layout used by repositories/BaseRepository.js:
//   {module}/{uid}/items/{itemId}   — todos, habits, goals, calendar,
//                                      workout, study, prayer, nutrition
//   users/{uid}                     — profile/settings document
//
// A single ownership check per module secures every document under it, which
// is exactly why BaseRepository roots everything under the user's own UID
// rather than storing a flat collection with a per-document ownerId field as
// the ONLY access control (that pattern is easy to get wrong; this one is
// not). Client-side `assertOwnership()` (utils/validators.js) is defense in
// depth on top of these rules, not a substitute for them — never assume
// unrestricted database access from client code alone.
// ---------------------------------------------------------------------------

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // users/{uid} — profile & settings
    match /users/{uid} {
      allow read, write: if isOwner(uid);

      // Phase 8: users/{uid}/dashboard/layout (DashboardLayoutService).
      // The parent rule above does NOT cover subcollections automatically —
      // this exact gap is what caused the Phase 6-discovered
      // notifications/{uid} bug; added proactively here instead of after
      // the fact.
      match /dashboard/{document} {
        allow read, write: if isOwner(uid);
      }

      // Phase 9: gamification subcollections — same proactive check.
      match /xp/{document} {
        allow read, write: if isOwner(uid);
      }
      match /badges/{document} {
        allow read, write: if isOwner(uid);
      }
      match /achievements/{document} {
        allow read, write: if isOwner(uid);
      }
      match /streaks/{document} {
        allow read, write: if isOwner(uid);
      }
      match /challenges/{document} {
        allow read, write: if isOwner(uid);
      }
    }

    // Phase 6: profile/settings/security/weatherPreferences — singleton
    // documents (one per user, see SingletonDocRepository.js), not
    // subcollections of users/{uid}.
    match /profile/{uid} {
      allow read, write: if isOwner(uid);
    }
    match /settings/{uid} {
      allow read, write: if isOwner(uid);
    }
    match /security/{uid} {
      allow read, write: if isOwner(uid);
    }
    match /weatherPreferences/{uid} {
      allow read, write: if isOwner(uid);
    }

    // {module}/{uid}/items/{itemId} — one rule block per module, all identical.
    match /todos/{uid}/items/{itemId} {
      allow read, write: if isOwner(uid);
    }
    match /habits/{uid}/items/{itemId} {
      allow read, write: if isOwner(uid);
    }
    match /goals/{uid}/items/{itemId} {
      allow read, write: if isOwner(uid);
    }
    match /calendar/{uid}/items/{itemId} {
      allow read, write: if isOwner(uid);
    }
    match /workout/{uid}/items/{itemId} {
      allow read, write: if isOwner(uid);
    }
    match /progressPhotos/{uid}/items/{itemId} {
      allow read, write: if isOwner(uid);
    }
    match /study/{uid}/items/{itemId} {
      allow read, write: if isOwner(uid);
    }
    match /subjects/{uid}/items/{itemId} {
      allow read, write: if isOwner(uid);
    }
    match /assignments/{uid}/items/{itemId} {
      allow read, write: if isOwner(uid);
    }
    match /exams/{uid}/items/{itemId} {
      allow read, write: if isOwner(uid);
    }
    match /projects/{uid}/items/{itemId} {
      allow read, write: if isOwner(uid);
    }
    match /studyNotes/{uid}/items/{itemId} {
      allow read, write: if isOwner(uid);
    }
    match /resources/{uid}/items/{itemId} {
      allow read, write: if isOwner(uid);
    }
    match /pomodoro/{uid} {
      allow read, write: if isOwner(uid);
    }
    match /prayer/{uid}/items/{itemId} {
      allow read, write: if isOwner(uid);
    }
    match /tasbeeh/{uid} {
      allow read, write: if isOwner(uid);
    }
    match /quranProgress/{uid} {
      allow read, write: if isOwner(uid);
    }
    match /quranBookmarks/{uid}/items/{itemId} {
      allow read, write: if isOwner(uid);
    }
    match /quranFavorites/{uid}/items/{itemId} {
      allow read, write: if isOwner(uid);
    }
    match /quranLog/{uid}/items/{itemId} {
      allow read, write: if isOwner(uid);
    }
    match /hadithFavorites/{uid}/items/{itemId} {
      allow read, write: if isOwner(uid);
    }
    match /nutrition/{uid}/items/{itemId} {
      allow read, write: if isOwner(uid);
    }
    match /water/{uid}/items/{itemId} {
      allow read, write: if isOwner(uid);
    }
    match /sleep/{uid}/items/{itemId} {
      allow read, write: if isOwner(uid);
    }
    match /bodyMeasurements/{uid}/items/{itemId} {
      allow read, write: if isOwner(uid);
    }
    match /shopping/{uid}/items/{itemId} {
      allow read, write: if isOwner(uid);
    }
    // Phase 6 audit fix: NotificationRepository (added in Phase 2) had no
    // matching rule here — every read/write would have been silently
    // blocked by the default-deny catch-all below. Confirmed and fixed.
    match /notifications/{uid}/items/{itemId} {
      allow read, write: if isOwner(uid);
    }
    // "statistics" (mentioned in the brief's example DB structure) is
    // deliberately NOT given its own repository/collection in this phase —
    // see MIGRATION_NOTES.md, "Remaining Technical Debt," for why.

    // Default deny: anything not explicitly matched above is inaccessible.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
