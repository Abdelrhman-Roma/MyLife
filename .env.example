# Copy this file to .env.local (already in .gitignore) and fill in your own
# Firebase project's values: Firebase Console -> Project Settings -> General
# -> Your apps -> SDK setup and configuration.
# Vite loads .env.local automatically; these must be prefixed VITE_ to be
# exposed to client-side code (see firebase/firebase.js).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
